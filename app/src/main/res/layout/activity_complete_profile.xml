<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Complete Your Profile"
            android:textColor="#11998e"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textAlignment="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Provide your verification details to finish registration"
            android:textColor="#757575"
            android:textSize="14sp"
            android:textAlignment="center"/>

        <!-- Phone Number with Country Code Prefix -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Phone Number"
            android:textColor="#424242"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <com.hbb20.CountryCodePicker
                android:id="@+id/ccpCountryCode"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/rounded_edittext_bg"
                app:ccp_defaultNameCode="PK"
                app:ccp_showNameCode="false"
                app:ccp_autoDetectCountry="false"
                app:ccp_textSize="14sp"
                android:gravity="center_vertical"/>

            <EditText
                android:id="@+id/etProfilePhone"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@drawable/rounded_edittext_bg"
                android:hint="3001234567"
                android:inputType="phone"
                android:paddingHorizontal="16dp"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:textColorHint="@color/black"/>
        </LinearLayout>

        <!-- CNIC -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="CNIC Number"
            android:textColor="#424242"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etProfileCnic"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/rounded_edittext_bg"
            android:hint="35202-1234567-1"
            android:inputType="number"
            android:paddingHorizontal="16dp"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:textColorHint="@color/black"/>

        <!-- Bike Number -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Bike Registration Number"
            android:textColor="#424242"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etProfileBikeNo"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/rounded_edittext_bg"
            android:hint="LHE-21-9988"
            android:inputType="textCapCharacters"
            android:paddingHorizontal="16dp"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:textColorHint="@color/black"/>

        <!-- Bike Model -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Bike Model"
            android:textColor="#424242"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etProfileBikeModel"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/rounded_edittext_bg"
            android:hint="Honda CD 70 (2024)"
            android:inputType="text"
            android:paddingHorizontal="16dp"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:textColorHint="@color/black"/>

        <!-- Country Spinner -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Country"
            android:textColor="#424242"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerCountry"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/rounded_edittext_bg" />

        <!-- State Spinner -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="State / Province"
            android:textColor="#424242"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerState"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/rounded_edittext_bg" />

        <!-- City Spinner -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="City"
            android:textColor="#424242"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerCity"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/rounded_edittext_bg" />

        <!-- Save & Register Button -->
        <Button
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#11998e"
            android:text="Save &amp; Register"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

        <ProgressBar
            android:id="@+id/profileProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>