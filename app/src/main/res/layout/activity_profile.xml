<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7F6"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Top Title Bar -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="24dp"
            android:paddingBottom="16dp"
            android:text="Profile"
            android:textColor="@color/primaryDark"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Profile Image & Camera Badge -->
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp">

            <!-- Circular Avatar Container supporting Initials & Images -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAvatar"
                android:layout_width="100dp"
                android:layout_height="100dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="50dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/primaryDark"
                app:strokeWidth="2dp"
                >

                <TextView
                    android:id="@+id/tvProfileInitial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="A"
                    android:textColor="@color/primaryDark"
                    android:textSize="36sp"
                    android:textStyle="bold" />

                <!-- Optional ImageView if you load a picture later via Glide/Picasso -->
                <ImageView
                    android:id="@+id/imgProfile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Camera Badge anchored properly to the avatar -->
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignEnd="@id/cardAvatar"
                android:layout_alignBottom="@id/cardAvatar"
                android:background="@drawable/bg_camera_badge"
                android:padding="6dp"
                android:src="@drawable/ic_camera"
                app:tint="#FFFFFF" />

        </RelativeLayout>

        <!-- User Name & Email -->
        <TextView
            android:id="@+id/tvFullName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Loading..."
            android:textColor="@color/primaryDark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="loading@email.com"
            android:textColor="#757575"
            android:textSize="14sp" />

        <!-- Main Card Container -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@color/white">

                <!-- Account Information Header & Edit Button -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_account_info"
                            app:tint="@color/primaryDark" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Account Information"
                            android:textColor="@color/primaryDark"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnEdit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:background="@color/white"
                        app:drawableStartCompat="@drawable/ic_edit"
                        android:drawablePadding="4dp"
                        android:paddingStart="12dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="6dp"
                        android:text="Edit"
                        android:textColor="@color/primaryDark"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center"/>
                </RelativeLayout>

                <!-- Full Name Field -->
                <include
                    android:id="@+id/layoutFullName"
                    layout="@layout/item_profile_field" />

                <!-- Email Field -->
                <include
                    android:id="@+id/layoutEmail"
                    layout="@layout/item_profile_field" />

                <!-- Primary Phone Field -->
                <include
                    android:id="@+id/layoutPhone"
                    layout="@layout/item_profile_field" />

                <!-- CNIC Field -->
                <include
                    android:id="@+id/layoutCnic"
                    layout="@layout/item_profile_field" />

                <!-- Country Field -->
                <include
                    android:id="@+id/layoutCountry"
                    layout="@layout/item_profile_field" />

                <!-- State Field -->
                <include
                    android:id="@+id/layoutState"
                    layout="@layout/item_profile_field" />

                <!-- City Field -->
                <include
                    android:id="@+id/layoutCity"
                    layout="@layout/item_profile_field" />

                <!-- Bike Model Field -->
                <include
                    android:id="@+id/layoutBikeModel"
                    layout="@layout/item_profile_field" />

                <!-- Bike Number Field -->
                <include
                    android:id="@+id/layoutBikeNumber"
                    layout="@layout/item_profile_field" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>